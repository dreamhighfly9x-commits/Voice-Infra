# Builds Voice-Frontend and serves the static output behind nginx, which
# reverse-proxies /api to the backend container (mirrors Vite's dev proxy in
# Voice-Frontend/vite.config.js so the app behaves the same in both).
FROM node:20-alpine AS build
WORKDIR /app
COPY Voice-Frontend/package*.json ./
RUN npm ci
COPY Voice-Frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY Voice-Infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
