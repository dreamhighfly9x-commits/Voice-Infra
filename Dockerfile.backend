# Voice-Backend image — Python 3.12, CPU inference (VieNeu-TTS is torch-free
# by default; see Voice-Backend/README.md for the CUDA extra if you need GPU).
FROM python:3.12-slim

WORKDIR /app

# libsndfile1 is soundfile's native dependency; build-essential covers any
# source builds pip falls back to when a wheel isn't published yet.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY Voice-Backend/requirements.txt ./requirements.txt
# CPU-only torch wheels: the default PyPI torch on Linux pulls several GB of
# CUDA libraries that a CPU host never uses.
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt

COPY Voice-Backend/app ./app

ENV VOICE_HOST=0.0.0.0 \
    VOICE_PORT=8000 \
    VOICE_STORAGE_DIR=/data

VOLUME ["/data"]
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
