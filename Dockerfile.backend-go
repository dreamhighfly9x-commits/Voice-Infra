# Voice-Backend Go API + worker — one image, two binaries. Compose picks
# which to run via `command:` (see docker-compose.yml `api` / `worker`).
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY Voice-Backend/go.mod Voice-Backend/go.sum ./
RUN go mod download
COPY Voice-Backend/ ./
RUN CGO_ENABLED=0 go build -o /out/api ./cmd/api \
    && CGO_ENABLED=0 go build -o /out/worker ./cmd/worker \
    && CGO_ENABLED=0 go build -o /out/promote-admin ./cmd/promote-admin

FROM alpine:3.20
RUN apk add --no-cache ca-certificates ffmpeg
COPY --from=build /out/api /usr/local/bin/api
COPY --from=build /out/worker /usr/local/bin/worker
COPY --from=build /out/promote-admin /usr/local/bin/promote-admin
EXPOSE 8080
CMD ["api"]
