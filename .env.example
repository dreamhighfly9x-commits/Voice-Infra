# Copy to Voice-Infra/.env on the host (never commit .env). Generate secrets with:
#   openssl rand -base64 48   (JWT_SECRET)
#   openssl rand -base64 32   (TTS_ENCRYPTION_KEY, must decode to 32 bytes)
JWT_SECRET=
TTS_ENCRYPTION_KEY=
# development on a bare-IP host without TLS (non-Secure refresh cookie); production/staging need HTTPS.
APP_ENV=development
APP_VERSION=dev
LOG_LEVEL=info
